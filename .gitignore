*.log

# Kotlin
.kotlin/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Build output
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
```